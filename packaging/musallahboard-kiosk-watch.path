[Unit]
Description=Watch the composed kiosk URL and reload the kiosk on change
Documentation=https://github.com/LensBridge/agent
# The agent writes /etc/musallahboard/kiosk-url (atomically: write .tmp then
# rename into place) on enrollment and whenever the base board-url changes.
# systemd watches the parent directory's inotify, so the rename-into-place is
# caught even when the file did not previously exist (first enrollment).

[Path]
# PathModified (not PathChanged): also fires on a plain write/rename without a
# preceding open of an existing file — which is exactly the agent's
# write-tmp + rename pattern on first enrollment.
PathModified=/etc/musallahboard/kiosk-url
Unit=musallahboard-kiosk-reload.service

[Install]
WantedBy=multi-user.target
